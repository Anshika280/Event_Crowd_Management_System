# =================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to '.env' for local backend development.
# =================================================================

PORT=5000
NODE_ENV=development

# Local MongoDB instance (or mongodb://mongodb:27017/eventcrowd inside Docker)
MONGO_URI=mongodb://localhost:27017/eventcrowd

# JWT Secret Key (replace with a strong 32+ character secret)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Razorpay Test Mode Credentials
# Replace these with your actual test keys from the Razorpay Dashboard
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret_optional
