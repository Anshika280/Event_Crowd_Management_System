# =================================================================
# Event Crowd Management System (ECMS) - Environment Configuration
# Copy this file to '.env' and fill in your actual production/test values.
# IMPORTANT: NEVER commit the actual '.env' file to source control.
# =================================================================

# --- Application Runtime ---
NODE_ENV=production
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=5173

# --- Database Configuration ---
# In Docker Compose, the database hostname is 'mongodb' (service name)
# For local bare-metal execution outside Docker, use: mongodb://localhost:27017/eventcrowd
MONGO_URI=mongodb://mongodb:27017/eventcrowd

# --- Authentication & Security ---
# Generate a strong 32+ character random string for production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# --- Razorpay Payment Gateway (Test Mode) ---
# Obtain from your Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret_optional

# --- Frontend Client Real-Time Socket Connection ---
# Browser-facing Socket.IO URL (default connects to http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000
