# ==========================================
# Root .gitignore - Event Crowd Management
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
**/.env
.env.*
**/.env.*
*.env
*.local
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Production build artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker & local database volume artifacts
.docker/
mongo_data/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
